<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" alignment="CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.demominidbeaver.controller.LoginController">
    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="DemoMiniDBeaver - Conexión">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <TitledPane text="1. Configuración Túnel SSH (JSch)" collapsible="false">
        <GridPane hgap="10" vgap="8">
            <Label text="SSH Host:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="sshHostField" promptText="Ej. 192.168.1.50 (Vacío si es directo)" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="SSH Puerto:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="sshPortField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="SSH Usuario:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="sshUserField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="SSH Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <PasswordField fx:id="sshPassField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
    </TitledPane>

    <TitledPane text="2. Configuración Base de Datos MariaDB" collapsible="false">
        <GridPane hgap="10" vgap="8">
            <Label text="DB Host:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="dbHostField" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="DB Puerto:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="dbPortField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Nombre BD:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="dbNameField" promptText="Nombre de la base en MariaDB" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="DB Usuario:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="dbUserField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="DB Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <PasswordField fx:id="dbPassField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </TitledPane>

    <Button text="Conectar y Sincronizar a SQLite" onAction="#onConnectClick" maxWidth="Infinity" prefHeight="35"/>
    <Label fx:id="statusLabel" text="Listo para conectar." wrapText="true"/>
</VBox>
